---
const businessName = "Abacus Campers";
import campervanImage from "../assets/abacus-campervan-1.JPG";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{businessName} | Campervan Adventures</title>
  </head>

  <body>
    <header>
      <nav>
        <div class="logo">ABACUS CAMPERS</div>

        <div class="links">
          <a href="#home">Home</a>
          <a href="#campers">Our Campers</a>
          <a href="#about">About Us</a>
          <a href="#contact">Contact</a>
        </div>

        <a class="book-button" href="#contact">Book Now</a>
      </nav>
    </header>

    <main id="home">
      <section class="hero">
        <div class="hero-content">
          <p class="eyebrow">EXPLORE • ESCAPE • DISCOVER</p>

          <h1>Your Adventure<br />Starts Here.</h1>

          <p class="intro">
            Discover Ireland your way with Abacus Campers.
            Comfortable campervans, unforgettable journeys,
            and the freedom to explore.
          </p>

          <div class="buttons">
            <a class="primary" href="#campers">Explore Our Campers</a>
            <a class="secondary" href="#contact">Plan Your Trip</a>
          </div>
        </div>
        <img src={campervanImage.src} alt="Abacus Campers campervan" class="hero-image" />
      </section>

      <section id="campers" class="section campers-section">
  <div class="section-heading">
    <p class="eyebrow">OUR CAMPERS</p>
    <h2>Find your perfect camper.</h2>
    <p>
      Comfortable, fully equipped campervans for exploring Ireland
      at your own pace.
    </p>
  </div>

  <div class="camper-card">
    <img
      src={campervanImage.src}
      alt="Abacus Campers campervan"
    />

    <div class="camper-card-content">
      <p class="eyebrow">ABACUS CAMPERS</p>
      <h3>Ready for your next adventure.</h3>
      <p>
        Everything you need for weekends away, road trips and
        unforgettable journeys around Ireland.
      </p>
      <a class="primary" href="#contact">Enquire Now</a>
    </div>
  </div>
</section>

<section id="about" class="section dark about-section">
  <div class="about-content">
    <p class="eyebrow">ABOUT US</p>
    <h2>Your road trip. Your way.</h2>

    <p>
      At Abacus Campers, we believe the best adventures are the ones
      where you choose the road.
    </p>

    <p>
      Our comfortable, practical campervans give you the freedom to
      explore Ireland at your own pace — from coastal escapes and
      mountain roads to spontaneous weekends away.
    </p>

    <a class="primary" href="#contact">Start Your Adventure</a>
  </div>
</section>

 <section id="contact" class="section contact-section">
  <div class="contact-content">
    <p class="eyebrow">START YOUR ADVENTURE</p>
    <h2>Ready to hit the road?</h2>

    <p>
      Planning your next escape? Get in touch with Abacus Campers
      and we'll help you start your journey.
    </p>

    <div class="contact-buttons">
      <a class="primary" href="mailto:hello@abacuscampers.ie">
        Email Us
      </a>

      <a class="secondary" href="tel:+353000000000">
        Call Us
      </a>
    </div>
  </div>
</section>
    </main>
    <footer class="footer">
  <div class="footer-brand">
    <strong>ABACUS CAMPERS</strong>
    <p>Adventure starts here.</p>
  </div>

  <div class="footer-links">
    <a href="#home">Home</a>
    <a href="#campers">Our Campers</a>
    <a href="#about">About Us</a>
    <a href="#contact">Contact</a>
  </div>

  <p class="copyright">
    © 2026 Abacus Campers. All rights reserved.
  </p>
</footer>
  </body>
</html>

<style>
  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    font-family: Arial, Helvetica, sans-serif;
    background: #f5f1e8;
    color: #17251d;
  }

  header {
    position: absolute;
    width: 100%;
    z-index: 10;
  }

  nav {
    max-width: 1200px;
    margin: auto;
    padding: 28px 30px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo {
    color: white;
    font-weight: 800;
    letter-spacing: 2px;
    font-size: 20px;
  }

  .links {
    display: flex;
    gap: 30px;
  }

  .links a {
    color: white;
    text-decoration: none;
    font-weight: 600;
  }

  .book-button,
  .primary {
    display: inline-block;
    background: #d97941;
    color: white;
    padding: 15px 24px;
    border-radius: 6px;
    text-decoration: none;
    font-weight: 700;
  }

  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 50px;
    padding: 130px 8%;
    background:
      linear-gradient(90deg, rgba(16, 35, 25, 0.96), rgba(16, 35, 25, 0.55)),
      linear-gradient(135deg, #294c38, #6e8266);
    color: white;
  }

  .hero-content {
    max-width: 720px;
  }

  .eyebrow {
    color: #df8b54;
    font-weight: 800;
    letter-spacing: 3px;
    font-size: 14px;
  }

  h1 {
    font-size: clamp(60px, 9vw, 110px);
    line-height: 0.92;
    margin: 20px 0 30px;
    letter-spacing: -5px;
  }

  .intro {
    max-width: 600px;
    font-size: 20px;
    line-height: 1.7;
    color: #e4e8e4;
  }

  .buttons {
    margin-top: 35px;
    display: flex;
    gap: 15px;
  }

  .secondary {
    display: inline-block;
    border: 2px solid white;
    color: white;
    padding: 13px 24px;
    border-radius: 6px;
    text-decoration: none;
    font-weight: 700;
  }

  .section {
    padding: 110px 8%;
    max-width: 1200px;
    margin: auto;
  }

  .section h2 {
    font-size: clamp(40px, 6vw, 70px);
    margin: 15px 0;
  }

  .section p {
    max-width: 700px;
    font-size: 19px;
    line-height: 1.7;
  }

  .dark {
    max-width: none;
    background: #17251d;
    color: white;
  }
.hero-image {
  width: 46%;
  max-width: 560px;
  height: 520px;
  object-fit: contain;
  border-radius: 18px;
}
  @media (max-width: 750px) {
    .links {
      display: none;
    }

    nav {
  padding: 18px 25px;
  }

  h1 {
  font-size: 48px;
  line-height: 0.95;
  letter-spacing: -3px;
  }

    .hero {
  padding: 45px 25px 60px;
  }

    .buttons {
      flex-direction: column;
      align-items: flex-start;
    }
  }
  .camper-card {
  margin-top: 35px;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 25px;
  padding: 25px;
  background: #eee8dc;
  border-radius: 24px;
  box-shadow: 0 18px 50px rgba(0, 0, 0, 0.08);
}

.camper-card img {
  width: 100%;
  max-width: 100%;
  height: 260px;
  object-fit: cover;
  border-radius: 18px;
}

.camper-card-content {
  width: 100%;
}
.camper-card-content h3 {
  font-size: 30px;
  margin: 10px 0 18px;
}

.camper-card-content p {
  line-height: 1.7;
  margin-bottom: 25px;
}
.contact-section {
  background: #f3efe7;
  padding: 110px 8%;
}

.contact-content {
  max-width: 850px;
  margin: 0 auto;
  text-align: center;
}

.contact-content h2 {
  font-size: clamp(42px, 6vw, 72px);
  line-height: 1;
  margin: 15px 0 25px;
  color: #294c38;
  letter-spacing: -3px;
}

.contact-content > p {
  max-width: 650px;
  margin: 0 auto 30px;
  line-height: 1.7;
  color: #5f6b68;
}

.contact-buttons {
  display: flex;
  justify-content: center;
  gap: 12px;
}

.contact-buttons .secondary {
  color: #294c38;
  border-color: #294c38;
}
.footer {
  background: #17251d;
  color: white;
  padding: 55px 8% 30px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 30px;
  flex-wrap: wrap;
}

.footer-brand strong {
  letter-spacing: 2px;
}

.footer-brand p {
  margin: 8px 0 0;
  color: #b9c4bd;
}

.footer-links {
  display: flex;
  gap: 25px;
}

.footer-links a {
  color: white;
  text-decoration: none;
  font-weight: 600;
}

.footer-links a:hover {
  color: #df8b54;
}

.copyright {
  width: 100%;
  padding-top: 25px;
  margin-top: 15px;
  border-top: 1px solid rgba(255, 255, 255, 0.15);
  color: #9eaaa3;
  font-size: 14px;
  text-align: center;
}

@media (max-width: 750px) {
  .footer {
    flex-direction: column;
    align-items: flex-start;
  }

  .footer-links {
    flex-direction: column;
    gap: 12px;
  }

}
.footer {
  background: #17251d;
  color: white;
  padding: 55px 8% 30px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 30px;
  flex-wrap: wrap;
}

.footer-brand strong {
  letter-spacing: 2px;
}

.footer-brand p {
  margin: 8px 0 0;
  color: #b9c4bd;
}

.footer-links {
  display: flex;
  gap: 25px;
}

.footer-links a {
  color: white;
  text-decoration: none;
  font-weight: 600;
}

.footer-links a:hover {
  color: #df8b54;
}

.copyright {
  width: 100%;
  padding-top: 25px;
  margin-top: 15px;
  border-top: 1px solid rgba(255, 255, 255, 0.15);
  color: #9eaaa3;
  font-size: 14px;
}
.hero {
  min-height: auto;
  flex-direction: column;
  align-items: flex-start;
  gap: 35px;
padding: 70px 25px;
}

.hero-content {
  max-width: 100%;
}

.hero-image {
  width: 100%;
  max-width: 100%;
  height: 300px;
  object-fit: cover;
}
</style>