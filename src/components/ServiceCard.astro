---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  title: string;
  items: string[];
  icon: 'engine' | 'home' | 'bolt' | 'paint';
  tone: 'blue' | 'yellow';
  image?: ImageMetadata;
  alt?: string;
}
const { title, items, icon, tone, image, alt = '' } = Astro.props;
---
<article class:list={['service-card', `service-card--${tone}`]}>
  <div class="service-card-media">
    {image ? <Image src={image} alt={alt} width={640} height={400} fit="cover" format="webp" loading="lazy" widths={[320, 640]} sizes="(max-width: 600px) 100vw, (max-width: 1000px) 50vw, 25vw" /> :
      <div class="service-image-placeholder"><span>Electrical &amp; solar photograph</span><small>Image placeholder — photograph pending</small></div>}
    <span class="service-badge" aria-hidden="true">
      <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        {icon === 'engine' && <><path d="M9 14h7l4-5h8v5l6 4v13H16l-5-6H6V14h3ZM21 9V5m-5 0h10M6 19H2m0-5v13m32-9h4v12h-4" /></>}
        {icon === 'home' && <><path d="m3 19 17-14 17 14M8 16v20h10V24h7v12h7V16M28 10V5h5v9" /></>}
        {icon === 'bolt' && <path d="m23 3-15 21h12l-3 13 15-22H20Z" />}
        {icon === 'paint' && <><path d="M8 6h25v10H8ZM33 11h4v12H22v5m-4 0h8v10h-8Z" /><path d="M4 8v6" /></>}
      </svg>
    </span>
  </div>
  <div class="service-card-body">
    <h3>{title}</h3>
    <ul>{items.map(item => <li><span aria-hidden="true">✓</span>{item}</li>)}</ul>
    <!-- Visual placeholder only: service destinations have not been agreed. -->
    <span class="service-more">Find out more <span aria-hidden="true">→</span><span class="service-sr-only"> — service navigation coming soon</span></span>
  </div>
</article>
