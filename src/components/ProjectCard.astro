---
import ProjectImage from './ProjectImage.astro';
import type { Project } from '../data/projects';
interface Props { project: Project; }
const { project } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<li class="project-slide">
  <a class="project-card" href={`${base}projects/${project.slug}/`}>
    <ProjectImage {...project.gallery[0]} />
    <div class="project-card-body">
      <h3>{project.title}</h3>
      <div class="project-tags">{project.categories.map(category => <span>{category}</span>)}</div>
      <span class="project-open">Open mock project <span aria-hidden="true">↗</span></span>
    </div>
  </a>
</li>
